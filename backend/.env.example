# Leave blank to use the explicitly labeled, rule-based interview demo.
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
# Q&A uses one attempt, then shows source excerpts if the provider is unavailable.
# This is a provider I/O timeout, not a deadline for database/vector retrieval.
QA_CHAT_TIMEOUT_SECONDS=30
# NVIDIA alternative: set the URL to https://integrate.api.nvidia.com/v1,
# LLM_MODEL=openai/gpt-oss-20b, and LLM_API_KEY to a securely stored NVIDIA key.
# NVIDIA_API_KEY is also accepted when the endpoint is NVIDIA.
# Optional separate OpenAI key for vector embeddings. A NVIDIA chat key is
# never reused for OpenAI embeddings. Leave blank for local retrieval.
EMBEDDING_API_KEY=
# local: credential-free keyword retrieval. supabase_vector: requires the
# knowledge_base.sql migration and index_knowledge.py with embeddings completed.
KNOWLEDGE_RETRIEVAL_MODE=local
# Configure both for business data, knowledge and report persistence.
# Apply supabase/database_setup.sql before enabling database mode.
# Use a server secret key (sb_secret_...) or
# legacy service_role key, never an anon/publishable key. Backend only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# auto: Supabase whenever both backend variables exist; otherwise offline demo.
# supabase: require the database and fail explicitly if unavailable.
# demo: use bundled sample operations/knowledge, for offline testing only.
BUSINESS_DATA_SOURCE=auto
# Analysis is read-only. Human approval can reserve sample stock and create
# demo work orders; factory progress is recorded through separate actions.
DATA_MODE=demo
# Recover queued approval jobs automatically after a backend restart.
# Demo actions are enabled only while manufacturing_settings.is_sample=true.
POST_APPROVAL_WORKER_ENABLED=true
# Cloud Run uses APP_ENV=production and AUTH_REQUIRED=true. List the email
# addresses of confirmed Supabase Auth users invited to review this demo.
APP_ENV=development
AUTH_REQUIRED=false
AUTH_ALLOWED_EMAILS=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
