# Leave blank locally to use the Vite /api proxy. On Vercel, use the Cloud Run
# service origin (https://SERVICE.run.app), without /api or a trailing slash.
VITE_API_BASE_URL=
# Enable for the shared interview deployment; create reviewer accounts in
# Supabase Auth and list their emails in backend AUTH_ALLOWED_EMAILS.
VITE_REQUIRE_AUTH=false
VITE_SUPABASE_URL=https://neeupsyqguamtfmpanmp.supabase.co
# Browser-safe publishable key (sb_publishable_...) or legacy anon key only.
# Never put a Supabase server key or NVIDIA/LLM key in a VITE_ variable.
VITE_SUPABASE_PUBLISHABLE_KEY=
